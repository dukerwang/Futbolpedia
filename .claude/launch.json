{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "prod",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "NODE_ENV=production",
        "npm",
        "start"
      ],
      "port": 3000
    }
  ]
}