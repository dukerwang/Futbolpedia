GEMINI_API_KEY=
API_FOOTBALL_KEY=

# Supabase secret key (server-only): the only credential that can write club_snapshots and era_snapshots
SUPABASE_SECRET_KEY=

# XI predictions (server-only): the server predicts each stored club's XI before its matches, one
# Gemini call per club per match, and scores the predictions afterwards. Set to off to stop them.
XI_PREDICTIONS=
# How far ahead a match gets its prediction, in hours (default 48)
XI_PREDICTION_WINDOW_HOURS=

# Gaffa club connect + in-app chat (server-only)
# Local Gaffa: http://127.0.0.1:3010 — do not point this at gaffa.live for local work.
GAFFA_BASE_URL=https://www.gaffa.live
FUTBOLPEDIA_READ_SECRET=
