GEMINI_API_KEY=

# The key every eval script uses (scripts/eval-live-questions.ts, scripts/smoke-model.ts): a Gemini key from a
# separate Google project with a small spending cap, so an eval can never spend the live app's budget.
# The scripts refuse to start without it and never fall back to GEMINI_API_KEY (--use-app-key overrides).
# Local only: commented out so AI Studio doesn't ask for it. Set it in .env.local.
# EVAL_GEMINI_API_KEY=
API_FOOTBALL_KEY=

# Supabase secret key (server-only): the only credential that can write club_managers, club_snapshots and era_snapshots
SUPABASE_SECRET_KEY=

# XI predictions (server-only): the server predicts each stored club's XI before its matches, one
# Gemini call per club per match, and scores the predictions afterwards. Set to off to stop them.
XI_PREDICTIONS=
# How far ahead a match gets its prediction, in hours (default 48)
XI_PREDICTION_WINDOW_HOURS=

# The scout's day (server-only): once a day, after the first prediction sweep, one Gemini call plans
# what to research and the server runs the plan. It needs SUPABASE_SECRET_KEY. Set to off to stop it.
SCOUT_DAY=
# Gemini calls the pass may spend in a day, the planning call included (default 30)
SCOUT_DAY_CALLS=
# Card review, inside the scout's day (server-only): re-rates current cards past their window, fills
# historical cards' data gaps from stored records, and drafts prime re-rates that a separate reviewer
# call must accept before they publish. Gemini calls it may spend in a day, apart from SCOUT_DAY_CALLS
# (default 24; 0 turns it off). It needs SUPABASE_SECRET_KEY and the card_reviews migration.
CARD_REVIEW_CALLS=

# Gaffa club connect + in-app chat (server-only)
# Local Gaffa: http://127.0.0.1:3010 — do not point this at gaffa.live for local work.
GAFFA_BASE_URL=https://www.gaffa.live
FUTBOLPEDIA_READ_SECRET=

# The server's Gemini key. Wins over GEMINI_API_KEY, which AI Studio overwrites at publish.
FUTBOLPEDIA_GEMINI_KEY=
